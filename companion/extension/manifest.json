{
  "manifest_version": 3,
  "name": "Bridge \u00b7 ChatGPT Continuity",
  "version": "0.14.0",
  "description": "Local project connections, reviewed messages and explicitly started, bounded goal loops.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
