[Unit]
Description=ChatGPT MCP tunnel (chatgpt-libresprite)
After=network-online.target libresprite-mcp.service
Wants=libresprite-mcp.service
ConditionPathExists=/home/bridge-user/.config/tunnel-client/chatgpt-libresprite.yaml
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/home/bridge-user/.local/bin/tunnel-client run --profile chatgpt-libresprite
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077

[Install]
WantedBy=default.target
