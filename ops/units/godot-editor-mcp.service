[Unit]
Description=Independent installed Godot editor MCP
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/bridge-user
Environment=GODOT_MCP_DEFAULT_TOOLSETS=inspection,runtime,editor,scene_edit,scripts,asset_import
Environment=GODOT_MCP_GODOT_BIN=/home/bridge-user/.local/lib/mcp-integration/godot-flatpak
Environment=GODOT_MCP_TRANSPORT=http
Environment=GODOT_MCP_HTTP_HOST=127.0.0.1
Environment=GODOT_MCP_HTTP_PORT=9090
Environment=GODOT_MCP_BRIDGE_URL=ws://127.0.0.1:9080
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/bridge-user/.local/share/pipx/venvs/godot-editor-mcp/bin/python -B /home/bridge-user/.local/lib/mcp-integration/godot_entry.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077

[Install]
WantedBy=default.target
